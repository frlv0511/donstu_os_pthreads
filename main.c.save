    for (int i = 0; i < COUNT_THREADS; i++) {
        pthread_join(threads[i], NULL);
    }

    // sys call for close file
    if (close(g_fd) < 0) {
        perror("close");
        return EXIT_FAILURE;
    }
    // remove mutex
    pthread_mutex_destroy(&g_lock);
    printf("main: all threads finished, file closed\n");
    return EXIT_SUCCESS;
}
